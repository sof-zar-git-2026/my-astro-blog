---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="navbar">
	<nav>
		<h2><a href="/" class="logo">♫ {SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/#artists">Artists</HeaderLink>
			<HeaderLink href="/#genres">Genres</HeaderLink>
			<HeaderLink href="/#discoveries">Discoveries</HeaderLink>
			<HeaderLink href="/#about">About</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.navbar {
		margin: 0;
		padding: 0 8%;
		background: #101019;
		border-bottom: 1px solid #292637;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}
	
	h2 {
		margin: 0;
		font-size: 21px;
		font-weight: 700;
	}

	.logo {
		color: #c4a7ff;
		text-decoration: none;
	}
	
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 24px;
	}
	
	.internal-links {
		display: flex;
		gap: 24px;
	}
	
	.internal-links :global(a) {
		padding: 22px 0.5em;
		color: #c5c1d2;
		font-size: 14px;
		text-decoration: none;
		border-bottom: 4px solid transparent;
		transition: color 0.2s ease, border-bottom-color 0.2s ease;
	}
	
	.internal-links :global(a:hover) {
		color: #c4a7ff;
	}
	
	.internal-links :global(a.active) {
		color: #c4a7ff;
		border-bottom-color: #a981f5;
		text-decoration: none;
	}

	@media (max-width: 700px) {
		.navbar {
			padding: 20px;
		}

		nav {
			flex-direction: column;
			justify-content: center;
			gap: 14px;
		}

		.internal-links :global(a) {
			padding: 10px 0.5em;
		}
	}
</style>