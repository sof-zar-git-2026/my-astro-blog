---
const today = new Date();
---

<footer class="footer">
	<div class="footer-content">
		<p class="footer-logo">♫ My Music Space</p>
		<p class="copyright">&copy; {today.getFullYear()} All rights reserved. Made with a love of music.</p>
	</div>
	
</footer>

<style>
	.footer {
		margin-top: 0;
		padding: 40px 24px;
		background: #101019;
		border-top: 1px solid #292637;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.footer-logo {
		margin: 0 0 8px;
		font-size: 16px;
		font-weight: 700;
		color: #c4a7ff;
	}

	.copyright {
		margin: 0;
		color: #aaa4bc;
		font-size: 13px;
	}

</style>
